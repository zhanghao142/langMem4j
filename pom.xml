<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.langmem4j</groupId>
    <artifactId>langmem4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>langmem4j</name>
    <description>
        langMem4j — Java 生态设计最干净的长期记忆管理中间件。
        以 MemoryManager 为主入口，提供可插拔的 MemoryStore / EmbeddingGenerator SPI，
        内置 InMemory 实现并支持 Qdrant 等向量数据库，可独立使用也可作为 LangChain4j / Spring AI 的工具函数暴露给 LLM Agent。
    </description>

    <modules>
        <module>langmem4j-core</module>
        <module>langmem4j-store-qdrant</module>
        <module>langmem4j-langgraph4j</module>
        <module>langmem4j-strategy</module>
        <module>langmem4j-tools-core</module>
        <module>langmem4j-tools</module>
        <module>langmem4j-observability</module>
        <module>langmem4j-spring-boot-starter</module>
        <module>langmem4j-examples</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Core-only dependencies: must stay minimal, no frameworks. -->
        <slf4j-api.version>2.0.16</slf4j-api.version>
        <junit-jupiter.version>5.11.0</junit-jupiter.version>
        <assertj-core.version>3.26.3</assertj-core.version>

        <!-- Adapter-side dependencies: versions below must be aligned with
             the external libraries currently in use. Confirm before V1 release. -->
        <langchain4j.version>1.19.0</langchain4j.version>
        <qdrant-client.version>1.19.0</qdrant-client.version>
        <spring-boot.version>3.3.5</spring-boot.version>
        <langgraph4j-core.version>1.8.25</langgraph4j-core.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Core runtime: logging API only, no binding. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j-api.version}</version>
            </dependency>

            <!-- Test stack shared across modules. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj-core.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Adapter-side BOMs; imported only by modules that need them. -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qdrant</groupId>
                <artifactId>client</artifactId>
                <version>${qdrant-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules. -->
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-store-qdrant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-tools-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-langgraph4j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-strategy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.langmem4j</groupId>
                <artifactId>langmem4j-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- langgraph4j-core (org.bsc.langgraph4j) — Store SPI. -->
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-core</artifactId>
                <version>${langgraph4j-core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>17</release>
                        <!-- Spring Boot 3.2+ requires -parameters for
                             @RequestParam/@PathVariable name resolution. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
